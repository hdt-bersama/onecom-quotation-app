# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env ke GitHub.

APP_TIMEZONE=Asia/Jakarta

# Login aplikasi (sangat disarankan). Jika APP_PASSWORD dikosongkan, login dimatikan.
APP_USER=admin
APP_PASSWORD=ganti-dengan-password-kuat

# Koneksi Supabase (Dashboard > Connect > "Session pooler" atau "Transaction pooler")
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=password-database-supabase-anda
DB_SSLMODE=require
